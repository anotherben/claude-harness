<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ben.pm2-browser-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pm2</string>
    <string>resurrect</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PM2_HOME</key>
    <string>__HOME__/.pm2</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pm2-browser-worker.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pm2-browser-worker.launchd.err.log</string>
</dict>
</plist>
