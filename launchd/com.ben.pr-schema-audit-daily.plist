<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ben.pr-schema-audit-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/.codex/skills/pr-schema-audit/scripts/daily-sweep.cjs</string>
    </array>

    <!-- 7:00 AM local time (system TZ = Australia/Melbourne). launchd StartCalendarInterval is local. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- cwd where node_modules/pg resolves, so the audit's pg() lookup succeeds. -->
    <key>WorkingDirectory</key>
    <string>__HOME__/helpdesk</string>

    <!-- launchd starts with a minimal env; add Homebrew bin so gh + node are found. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.codex/skills/pr-schema-audit/daily.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.codex/skills/pr-schema-audit/daily.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
