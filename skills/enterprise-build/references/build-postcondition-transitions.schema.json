{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/enterprise-build-postconditions.v3.json",
  "title": "Enterprise build postcondition status registry",
  "type": "object",
  "required": [
    "schema",
    "agent_id",
    "slug",
    "contract_file",
    "build_packet_file",
    "command_receipt_log",
    "head_sha",
    "postconditions"
  ],
  "properties": {
    "schema": {
      "const": "enterprise-build-postconditions.v3"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "contract_file": {
      "type": "string",
      "minLength": 1
    },
    "build_packet_file": {
      "type": "string",
      "minLength": 1
    },
    "command_receipt_log": {
      "type": "string",
      "minLength": 1
    },
    "base_ref": {
      "type": "string"
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string",
      "minLength": 1
    },
    "head_sha_after": {
      "type": "string"
    },
    "current_git_state": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/postcondition"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postcondition": {
      "type": "object",
      "required": [
        "id",
        "status",
        "contracted_reason",
        "expected_red",
        "expected_green"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PC-[A-Za-z0-9._-]+$"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "red",
            "green",
            "blocked",
            "recycled",
            "verified"
          ]
        },
        "status_reason": {
          "type": "string"
        },
        "contracted_reason": {
          "type": "string",
          "minLength": 1
        },
        "allowed_runtime_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_test_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_artifact_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "test_file": {
          "type": "string"
        },
        "test_name": {
          "type": "string"
        },
        "runtime_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "expected_red": {
          "type": "string",
          "minLength": 1
        },
        "expected_green": {
          "type": "string",
          "minLength": 1
        },
        "red_receipt_id": {
          "type": "string"
        },
        "green_receipt_id": {
          "type": "string"
        },
        "receipt_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "blocker_reason": {
          "type": "string"
        },
        "recycle_reason": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string"
        },
        "log_path": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "blocker_reason"
                ],
                "properties": {
                  "blocker_reason": {
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "status_reason"
                ],
                "properties": {
                  "status_reason": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "recycled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "recycle_reason"
                ],
                "properties": {
                  "recycle_reason": {
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "status_reason"
                ],
                "properties": {
                  "status_reason": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "red"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "red_receipt_id"
            ],
            "properties": {
              "red_receipt_id": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "green"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "red_receipt_id",
              "green_receipt_id"
            ],
            "properties": {
              "red_receipt_id": {
                "minLength": 1
              },
              "green_receipt_id": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
